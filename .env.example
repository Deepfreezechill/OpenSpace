# Scion Environment Configuration
# Copy to .env and customize: cp .env.example .env

# ── Required for HTTP transports (docker compose) ──────────────────
SCION_MCP_BEARER_TOKEN=your-secret-token-here

# ── Optional: LLM Provider ─────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# SCION_API_KEY=your-scion-cloud-key

# ── Optional: Server Settings ──────────────────────────────────────
# SCION_MCP_HOST=0.0.0.0
# SCION_MCP_PORT=8000
# SCION_MCP_TRANSPORT=streamable-http
# SCION_LOG_LEVEL=INFO
# SCION_METRICS_ENABLED=true
# SCION_SHUTDOWN_TIMEOUT=30
# SCION_DEBUG=false
